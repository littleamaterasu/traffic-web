TABAPI_KEY=

# Số tháng lịch sử traffic cần lấy. TabAPI hỗ trợ từ 3 đến 12.
TRAFFIC_MONTHS=3

# SerpApi key cho panel Google Ads Transparency (https://serpapi.com).
SERPAPI_KEY=

WHOIS_API_KEY=

# SE Ranking Data API key cho các panel SEO/quảng cáo bổ sung (https://seranking.com/api). Chỉ đọc phía máy chủ.
SE_RANKING_API_KEY=

# URL gốc của dịch vụ Trustpilot scraper chạy cục bộ (ví dụ http://127.0.0.1:5000). Chỉ đọc phía máy chủ, không dùng tiền tố NEXT_PUBLIC.
TRUSTPILOT_SCRAPER_URL=
